# Copy this file to .env and fill in your keys.
# .env is in .gitignore — never commit your keys.

# Required: OpenAI API key. The Summer School provides this.
OPENAI_API_KEY=sk-...

# Optional: DeepSeek API key, used as cost-effective fallback for high-volume agents.
DEEPSEEK_API_KEY=

# Optional: which OpenAI models to use.
# These names are illustrative — pick whatever your account has access to.
OPENAI_MODEL_TOP=gpt-4o
OPENAI_MODEL_MID=gpt-4o-mini

# Hard cap on tokens per run, in input+output combined. Prevents runaway costs.
MAX_TOKENS_PER_RUN=2000000
